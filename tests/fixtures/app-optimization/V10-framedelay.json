{
  "id": "app-optimization-V10-framedelay",
  "name": "App Optimization V10 Frame Delay",
  "description": "Frozen R2 rack followed by Frame Delay for V10 CPU-path profiling.",
  "reader": {
    "rawType": "INTERLEAVED",
    "law": "NONE",
    "sign": "UNSIGNED",
    "bits": 8,
    "endianess": "LITTLE_ENDIAN",
    "colorSpace": "RGB"
  },
  "writer": {
    "rawType": "INTERLEAVED",
    "law": "NONE",
    "sign": "UNSIGNED",
    "bits": 8,
    "endianess": "LITTLE_ENDIAN",
    "colorSpace": "RGB"
  },
  "equalize": false,
  "blendMode": "NONE",
  "blendAmount": 0,
  "filters": [],
  "videoFilters": [
    {
      "id": "r2-procamp",
      "type": "procamp",
      "enabled": true,
      "params": {
        "pedestal": 0,
        "videoGain": 1,
        "saturation": 1.1,
        "chromaPhase": 0,
        "whiteClip": 240
      }
    },
    {
      "id": "r2-solarizer",
      "type": "solarizer",
      "enabled": true,
      "params": {
        "threshold": 128,
        "gamma": 1.4,
        "pedestal": 10,
        "invert": 1
      }
    },
    {
      "id": "r2-colorizer",
      "type": "colorizer",
      "enabled": true,
      "params": {
        "lowHue": 210,
        "midHue": 35,
        "highHue": 85,
        "bands": 4,
        "mix": 0.85
      }
    },
    {
      "id": "v10-framedelay",
      "type": "framedelay",
      "enabled": true,
      "params": {
        "delayFrames": 6,
        "echoMix": 0.5,
        "decay": 0.85,
        "freeze": 0,
        "stutter": 0.0
      }
    }
  ],
  "chain": [
    {
      "kind": "video",
      "id": "r2-procamp"
    },
    {
      "kind": "video",
      "id": "r2-solarizer"
    },
    {
      "kind": "video",
      "id": "r2-colorizer"
    },
    {
      "kind": "video",
      "id": "v10-framedelay"
    }
  ]
}
