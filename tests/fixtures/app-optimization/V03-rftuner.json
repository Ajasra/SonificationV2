      "params": {
        "lowHue": 210,
        "midHue": 35,
        "highHue": 85,
        "bands": 4,
        "mix": 0.85
      }
    },
    {
      "id": "v03-rftuner",
      "type": "rftuner",
      "enabled": true,
      "params": {
        "ghostOffset": 24,
        "ghostGain": 0.35,
        "rfNoise": 0.18,
        "humBar": 0.2,
        "fineTune": 0
      }
    }
  ],
  "chain": [
    {
      "kind": "video",
      "id": "r2-procamp"
    },
    {
      "kind": "video",
      "id": "r2-solarizer"
    },
    {
      "kind": "video",
