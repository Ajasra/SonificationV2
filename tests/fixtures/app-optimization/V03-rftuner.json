{
  "id": "app-optimization-V03-rftuner",
  "name": "App Optimization V03 RF Tuner",
  "description": "Frozen R2 spatial rack followed by RF Tuner for V03 CPU-path profiling.",
  "reader": {
    "rawType": "INTERLEAVED",
    "law": "NONE",
    "sign": "UNSIGNED",
    "bits": 8,
    "endianess": "LITTLE_ENDIAN",
    "colorSpace": "RGB"
  },
  "writer": {
    "rawType": "INTERLEAVED",
    "law": "NONE",
    "sign": "UNSIGNED",
    "bits": 8,
    "endianess": "LITTLE_ENDIAN",
    "colorSpace": "RGB"
  },
  "equalize": false,
  "blendMode": "NONE",
  "blendAmount": 0,
  "filters": [],
  "videoFilters": [
    {
      "id": "r2-procamp",
      "type": "procamp",
      "enabled": true,
      "params": {
        "pedestal": 0,
        "videoGain": 1,
        "saturation": 1.1,
        "chromaPhase": 0,
        "whiteClip": 240
      }
    },
    {
      "id": "r2-solarizer",
      "type": "solarizer",
