{
  "name": "sonification-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:gpu": "node scripts/test-gpu-browser.mjs",
    "setup:wasm": "node scripts/setup-wasm.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "node --test tests/wasm_conformance.test.mjs",
    "benchmark:wasm": "node scripts/benchmark-wasm.mjs",
    "dev:benchmark": "vite --config vite.benchmark.config.ts",
    "build:benchmark": "tsc && vite build --config vite.benchmark.config.ts",
    "build": "tsc && vite build",
    "build:backend": "npm run build && node scripts/copy-pocketbase-site.mjs",
    "seed:production": "node scripts/seed-production-presets.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mp4-muxer": "^5.2.2",
    "pocketbase": "^0.28.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@webgpu/types": "0.1.74",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
